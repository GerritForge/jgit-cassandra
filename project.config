[project]
	description = JGit DFS Backend implementation based on Apache Cassandra
[access]
	inheritFrom = Private-Projects
[access "refs/*"]
	owner = group user/Haithem Jarraya (hjarraya)
	owner = group user/Luca Milanesio (lucamilanesio)
	read = group user/Haithem Jarraya (hjarraya)
	read = group user/Luca Milanesio (lucamilanesio)
	push = group user/Haithem Jarraya (hjarraya)
	push = group user/Luca Milanesio (lucamilanesio)
	label-Code-Review = -2..+2 group user/Haithem Jarraya (hjarraya)
	label-Code-Review = -2..+2 group user/Luca Milanesio (lucamilanesio)
	label-Verified = -1..+1 group user/Haithem Jarraya (hjarraya)
	label-Verified = -1..+1 group user/Luca Milanesio (lucamilanesio)
	rebase = group user/Haithem Jarraya (hjarraya)
	rebase = group user/Luca Milanesio (lucamilanesio)
	removeReviewer = group user/Haithem Jarraya (hjarraya)
	removeReviewer = group user/Luca Milanesio (lucamilanesio)
	submit = group user/Haithem Jarraya (hjarraya)
	submit = group user/Luca Milanesio (lucamilanesio)
